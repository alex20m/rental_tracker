# You do not write these into a file by hand.
#
# They are set on the hosting project (see SETUP.md), and you pull them down
# with `npx vercel env pull .env.local`. That way local development reads the
# same source of truth as the deployment, and a rotated credential arrives with
# one command instead of drifting.
#
# --- Supplied by the database integration; never set these yourself ---
#
# DATABASE_URL=             # pooled — what the app queries through
# DATABASE_URL_UNPOOLED=    # direct — what migrations need for their lock
#
# --- Neon Auth. Confirm the names with `neonctl neon-auth status --output json`
#     rather than assuming them ---
#
# NEON_AUTH_BASE_URL=       # https://<your-project>.neon.tech
# NEON_AUTH_COOKIE_SECRET=  # yours to generate; >= 32 chars or the SDK throws
#
# --- Yours to set ---
#
# APP_URL=                  # https://your-app.vercel.app — links in emails, redirects
