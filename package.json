{
  "name": "rental-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Track rental apartments, their co-owners and ownership shares, and prepare each owner\u2019s Finnish rental income tax declaration.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_COVERAGE=1 next build && playwright test",
    "migrate": "tsx db/migrate.ts",
    "migrate:new": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language sql"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "monocart-coverage-reports": "^2.13.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
